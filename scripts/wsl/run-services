#!/usr/bin/env bash
set -Eeuo pipefail

WEB_DIR="${WEB_DIR:?WEB_DIR is required}"
SERVICE_DIR="${SERVICE_DIR:?SERVICE_DIR is required}"

cd "$SERVICE_DIR/cloudrun"
python3 -c 'from app import serve; serve()' &
backend_pid=$!

cd "$WEB_DIR"
# 提供已构建的生产资源；浏览器 API 请求保持同源，由 Vite 转发到 Flask。
VITE_BASE_PATH=/ VITE_API_BASE_URL=/ npm run preview -- --host 0.0.0.0 --port 5173 --strictPort &
frontend_pid=$!

cleanup() {
  kill "$backend_pid" "$frontend_pid" 2>/dev/null || true
  wait "$backend_pid" "$frontend_pid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM
wait -n "$backend_pid" "$frontend_pid"
