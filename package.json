{
  "name": "trading-toolkit-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:check:delivery": "prettier --check src/main.js src/api/contracts.js src/api/market.js src/api/convertible.js src/api/lof.js src/api/hkipo.js src/api/closedEnd.js src/api/user.js src/views/Lof.vue tests/api-contract.mjs tests/market-smoke.mjs tests/placement-export.mjs tests/lof-market-overview.mjs openspec/changes/lof-market-overview-signals .github/workflows/ci.yml .github/workflows/cloudflare-pages.yml",
    "verify:contract": "node tests/api-contract.mjs",
    "verify:placement-export": "node tests/placement-export.mjs",
    "verify:placement-browser": "node tests/verify_default_placement_metrics.mjs",
    "verify:lof-market-overview": "node tests/lof-market-overview.mjs",
    "verify:market-browser": "node tests/market-smoke.mjs",
    "verify:quote-barrage": "node tests/quote-barrage.mjs",
    "debug:filter": "node scripts/browser/debug_filter.mjs",
    "debug:page": "node scripts/browser/debug_page.mjs",
    "verify:gap": "node scripts/browser/verify_gap.mjs",
    "verify:held": "node scripts/browser/verify_held.mjs",
    "verify:list": "node scripts/browser/verify_list.mjs",
    "verify:timeline": "node scripts/browser/verify_timeline.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@sentry/vue": "^10.68.0",
    "axios": "^1.18.1",
    "element-plus": "^2.14.2",
    "pinia": "^3.0.4",
    "sass": "^1.101.0",
    "vue": "^3.5.39",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "vite": "^8.1.1"
  }
}
